{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sharkyydrop",
  "version": "0.1.0",
  "identifier": "ru.sharkyydrop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sharkyydrop",
        "width": 920,
        "height": 660,
        "minWidth": 760,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "AirDrop для всех",
    "longDescription": "Sharkyydrop: перекидывай файлы и ссылки между компьютером и телефоном по QR-коду. Без облака, аккаунтов и установки приложений на телефон.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
